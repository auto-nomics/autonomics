# =============================================================================
# Garage configuration template — rendered on the host by
# scripts/render-garage-config.sh using `envsubst`.
#
# Source of truth for the runtime garage.toml; do NOT hand-edit
# infra/docker/garage/garage.toml directly — it is regenerated every
# `make up` and is git-ignored.
#
# Placeholders follow envsubst syntax (${VAR:-default}). The list of
# substituted variables is whitelisted in render-garage-config.sh so
# unrelated .env entries never leak into the rendered config.
# =============================================================================

metadata_dir = "/var/lib/garage/meta"
metadata_snapshots_dir = "/var/lib/garage/snapshots"
metadata_auto_snapshot_interval = "6h"
metadata_fsync = true

db_engine = "lmdb"
replication_factor = 1
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "${GARAGE_RPC_PUBLIC_ADDR}"
rpc_secret = "${GARAGE_RPC_SECRET}"

[[data_dir]]
path = "/mnt/disk2"
capacity = "${GARAGE_DISK_CAPACITY}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[k2v_api]
api_bind_addr = "[::]:3904"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "${GARAGE_ADMIN_TOKEN}"
metrics_token = "${GARAGE_METRICS_TOKEN}"
