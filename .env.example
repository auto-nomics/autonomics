###############################################################################
# Autonomics workspace — environment variables (TEMPLATE)
#
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Covers every service in the workspace:
#   - External APIs (OpenGWAS, OpenAlex, UMLS, E-Utils, Embase)
#   - Docker data lake (Iceberg, Garage, Lakekeeper)
#   - LLM provider API keys
#   - DNAnexus / UK Biobank
#   - Aliyun OSS
#   - KMS / app paths
###############################################################################

# ── LLM Provider API Keys ────────────────────────────────────────────────────
# Required when using the corresponding LLM provider.

MIMO_API_KEY=                          # Xiaomi Mimo provider
SENSENOVA_API_KEY=                     # SenseNova provider
MINIMAX_API_KEY=                       # MiniMax provider
DEEPSEEK_API_KEY=                      # DeepSeek provider
ZAI_API_KEY=                           # Z.ai provider

# ── Custom Gateway (integration tests) ───────────────────────────────────────
# Optional — defaults are provided for test code.

CUSTOM_BASE_URL=https://your-custom-gateway.example.com/v1/anthropic
CUSTOM_MODEL_NAME=claude-3-5-sonnet-latest
CUSTOM_BEARER_TOKEN=

# ── External APIs ────────────────────────────────────────────────────────────
OPENGWAS_TOKEN=                        # JWT bearer for OpenGWAS API
OPENALEX_API_KEY=                      # OpenAlex API key
UMLS_API_KEY=                          # UMLS Terminology Services API key
EUTILS_API_KEY=                        # NCBI E-utilities (raises 3→10 req/s)
EMBASE_API_KEY=                        # Elsevier Embase API key
EMBASE_INSTTOKEN=                      # institution token (optional)
EMBASE_AUTHTOKEN=                      # OAuth bearer token (optional)

# ── Iceberg Catalog DB ───────────────────────────────────────────────────────
ICEBERG_DB_USER=admin
ICEBERG_DB_PASSWORD=change-me
ICEBERG_DB_NAME=iceberg

# ── Iceberg S3 (Garage) ──────────────────────────────────────────────────────
ICEBERG_S3_REGION=garage
ICEBERG_S3_BUCKET=datalake
ICEBERG_S3_WAREHOUSE=s3://datalake/
ICEBERG_S3_ACCESS_KEY_ID=your-garage-access-key
ICEBERG_S3_SECRET_ACCESS_KEY=your-garage-secret-key
ICEBERG_S3_ENDPOINT_INTERNAL=http://garage:3900
ICEBERG_S3_ENDPOINT_PUBLIC=http://localhost:3900
ICEBERG_REST_PORT=8181
ICEBERG_REST_URI=http://localhost:8181/catalog

# ── Garage secrets ───────────────────────────────────────────────────────────
GARAGE_RPC_SECRET=your-rpc-secret-64-hex-chars
GARAGE_ADMIN_TOKEN=your-admin-token
GARAGE_METRICS_TOKEN=your-metrics-token
GARAGE_ACCESS_KEY_ID=your-garage-access-key
GARAGE_SECRET_ACCESS_KEY=your-garage-secret-key
GARAGE_S3_PORT=3900

# Garage data directories (host paths for bind mounts)
GARAGE_META_DIR=/var/lib/garage/meta
GARAGE_SNAPSHOTS_DIR=/var/lib/garage/snapshots
GARAGE_DATA_DIR_DISK1=/mnt/disk1/garage/data
GARAGE_DATA_DIR_DISK2=/mnt/disk2/garage/data

# ── Lakekeeper ───────────────────────────────────────────────────────────────
LAKEKEEPER_PORT=8181
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me-in-production
LAKEKEEPER__SERVER_IMAGE=quay.io/lakekeeper/catalog:latest-main

# ── DNAnexus / UK Biobank ────────────────────────────────────────────────────
DX_AUTH_TOKEN=                         # dx toolkit auth token
DX_PROJECT_CONTEXT_ID=                 # project-context hash, e.g. project-J3...

# ── Aliyun OSS ───────────────────────────────────────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ── Application Paths ────────────────────────────────────────────────────────
# Optional — each has a sensible default.

PHLOEM_CONFIG=phloem.json              # phloem-server config file path
BIBLIOGRAPHY_SEARCH_DIR=/mnt/disk1/project/bibliography-search
DOWNLOAD_DIR_PATH=/mnt/disk2/dataset/autonomics_data
KMS_DB_PATH=/mnt/disk3/dendrite/data/kms_sqlite.db
KMS_LOG_PATH=/mnt/disk3/dendrite/data/kms.log

# ── Logging ──────────────────────────────────────────────────────────────────
# Controls tracing log levels. Required by dendrite/kms_tui (uses from_default_env).
# Optional for phloem-server and phloem-tui (use try_from_default_env with fallback).

RUST_LOG=info                          # e.g. phloem_server=debug,tower_http=debug
