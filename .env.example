###############################################################################
# Autonomics workspace — environment variables (TEMPLATE)
#
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Covers every service in the workspace:
#   - External APIs (OpenGWAS, OpenAlex, UMLS, E-Utils, Embase)
#   - LLM provider API keys
#   - DNAnexus / UK Biobank
#   - Aliyun OSS
#   - KMS / app paths
###############################################################################



# ── External APIs ────────────────────────────────────────────────────────────
OPENGWAS_TOKEN=                        # JWT bearer for OpenGWAS API
OPENALEX_API_KEY=                      # OpenAlex API key
UMLS_API_KEY=                          # UMLS Terminology Services API key
EUTILS_API_KEY=                        # NCBI E-utilities (raises 3→10 req/s)
EMBASE_API_KEY=                        # Elsevier Embase API key
EMBASE_INSTTOKEN=                      # institution token (optional)
EMBASE_AUTHTOKEN=                      # OAuth bearer token (optional)

# -- Garage object storage (infra/docker) -------------------------------------
# For a local test stack, use writable host paths for GARAGE_*_DIR. Empty
# Garage secrets are generated by `make check-env` in infra/docker.
GARAGE_BUCKET=datalake
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_RPC_PUBLIC_ADDR=127.0.0.1:3901
GARAGE_DISK_CAPACITY=20G
GARAGE_META_DIR=./.data/meta
GARAGE_SNAPSHOTS_DIR=./.data/snapshots
GARAGE_DATA_DIR_DISK1=./.data/disk1

# -- k3s container execution --------------------------------------------------
# Required for the TUI/runtime process and k3s Jobs to share the same workspace
# and panel-cache PVC paths. KUBECONFIG may be omitted when ~/.kube/config is
# already readable, but the explicit path is safer for isolated deployments.
#
# When launching the TUI through start.sh/Podman, also mount kubeconfig and the
# two AUTONOMICS_* paths below into the container at identical paths.
KUBECONFIG=/home/<user>/.kube/autonomics-k3s.yaml
AUTONOMICS_K3S_NAMESPACE=autonomics
AUTONOMICS_K3S_CONTEXT=
AUTONOMICS_K3S_WORKSPACE_PVC=autonomics-workspace
AUTONOMICS_K3S_WORKSPACE_ROOT=/var/lib/autonomics/k3s/workspace
AUTONOMICS_K3S_PANEL_PVC=autonomics-panels
AUTONOMICS_PANEL_CACHE_ROOT=/var/lib/autonomics/k3s/panels
AUTONOMICS_K3S_PANEL_PVC_PREFIX=
AUTONOMICS_K3S_POLL_INTERVAL_MS=500

# ── DNAnexus / UK Biobank ────────────────────────────────────────────────────
DX_AUTH_TOKEN=                         # dx toolkit auth token
DX_PROJECT_CONTEXT_ID=                 # project-context hash, e.g. project-J3...

# ── Aliyun OSS ───────────────────────────────────────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ── Application Paths ────────────────────────────────────────────────────────
# Optional — each has a sensible default.

PHLOEM_CONFIG=phloem.json              # phloem-server config file path
BIBLIOGRAPHY_SEARCH_DIR=/mnt/disk1/project/bibliography-search
DOWNLOAD_DIR_PATH=/mnt/disk2/dataset/autonomics_data
KMS_DB_PATH=/mnt/disk3/dendrite/data/kms_sqlite.db
KMS_LOG_PATH=/mnt/disk3/dendrite/data/kms.log
AUTONOMICS_MIXER_RESOURCE_SOURCE=     # host MiXeR bundle root; defaults to /data then /mnt/data
AUTONOMICS_PLINK_REF_SOURCE_ROOT=     # host 1000G PLINK root; defaults to complete deployed roots
PLINK_REF_PREFIX_TEMPLATE=            # shared prefix template, e.g. /refs/chr{N}/1000G.EUR.chr{N}.qc
LAVA_PLINK_REF_PREFIX_TEMPLATE=       # LAVA-only prefix template; defaults to the VFS panel mount

# ── Logging ──────────────────────────────────────────────────────────────────
# Controls tracing log levels. Required by dendrite/kms_tui (uses from_default_env).
# Optional for phloem-server and phloem-tui (use try_from_default_env with fallback).

RUST_LOG=info                          # e.g. phloem_server=debug,tower_http=debug
