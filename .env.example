###############################################################################
# Autonomics workspace — environment variables (TEMPLATE)
#
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Covers every service in the workspace:
#   - External APIs (OpenGWAS, OpenAlex, UMLS, E-Utils, Embase, MinerU)
#   - LLM provider API keys
#   - DNAnexus / UK Biobank
#   - Aliyun OSS
#   - KMS / app paths
###############################################################################

# ── External APIs ────────────────────────────────────────────────────────────
OPENGWAS_TOKEN=            # JWT bearer for OpenGWAS API
OPENALEX_API_KEY=          # OpenAlex API key
UMLS_API_KEY=              # UMLS Terminology Services API key
EUTILS_API_KEY=            # NCBI E-utilities (raises 3→10 req/s)
PROTOCOLS_IO_ACCESS_TOKEN= # protocols.io bearer/client access token
#ENDPOINT_PROTOCOLS_IO_URL=https://www.protocols.io
EMBASE_API_KEY=   # Elsevier Embase API key
EMBASE_INSTTOKEN= # institution token (optional)
EMBASE_AUTHTOKEN= # OAuth bearer token (optional)

HUGGING_FACE_TOKEN=

# Optional; defaults to https://string-db.org. Use a version-specific host
# (for example https://version-12-0.string-db.org) for reproducible runs.
#ENDPOINT_STRING_URL=https://string-db.org

# Optional; defaults to the human Enrichr/Speedrichr hosts. Non-human hosts
# (FlyEnrichr, YeastEnrichr, WormEnrichr, FishEnrichr) can be pinned instead.
#ENDPOINT_ENRICHR_URL=https://maayanlab.cloud/Enrichr
#ENDPOINT_SPEEDRICHR_URL=https://maayanlab.cloud/speedrichr/api

# MinerU cloud API for bibliographic full-text (PDF) extraction. Without a
# key, extraction falls back to the local chain (pdf-extract + tesseract).
MINERU_API_KEY= # JWT bearer from mineru.net (inference API)
#MINERU_API_URL=https://mineru.net     # optional; defaults to https://mineru.net

# -- Garage object storage (infra/docker) -------------------------------------
# For a local test stack, use writable host paths for GARAGE_*_DIR. Empty
# Garage secrets are generated by `make check-env` in infra/docker.
GARAGE_BUCKET=datalake
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_RPC_PUBLIC_ADDR=127.0.0.1:3901
GARAGE_DISK_CAPACITY=20G
GARAGE_META_DIR=./.data/meta
GARAGE_SNAPSHOTS_DIR=./.data/snapshots
GARAGE_DATA_DIR_DISK1=./.data/disk1

# -- container execution (Podman) ---------------------------------------------
# One-shot container_command nodes execute through the local Podman runtime.
# Defaults use the current user's home and XDG state directory. Run the TUI on
# the host (or provide a remote Podman CLI) because start.sh's TUI container
# does not mount a Podman socket.
#AUTONOMICS_PODMAN_PROGRAM=podman
# Three distinct DAG storage roles:
# 1. container task cache / execution workdirs (cache-local outputs)
#$HOME/.local/state/autonomics/podman/workspace is the legacy spelling
#AUTONOMICS_DAG_WORK_ROOT=$HOME/.autonomics/state/work
# 2. immutable final artifacts are published through each node's VFS artifact_prefix
# 3. local executor receipts and DataFrame evidence
#AUTONOMICS_DAG_RECEIPTS_ROOT=$HOME/.autonomics/state/dag-tasks
#$HOME/.autonomics/state/dag-tasks can also be set with legacy AUTONOMICS_DAG_TASKS_ROOT
#AUTONOMICS_PANEL_CACHE_ROOT=$HOME/.autonomics/panels
# Budget for podman create/image pull on a cold host, in seconds (default 3600).
#AUTONOMICS_PODMAN_PULL_TIMEOUT_SECS=3600

# -- central DAG lifecycle & storage governance (daemon DataEngineManager) -----
# Idle actor eviction: sessions with no command for this long are stopped
# (active runs are never evicted). Default 86400 (24h).
#AUTONOMICS_DAG_SESSION_IDLE_SECS=86400
# Release in-memory node outputs of sessions idle for this long (topology,
# history and artifacts are kept). Default 3600 (1h).
#AUTONOMICS_DAG_OUTPUT_CACHE_IDLE_SECS=3600
# Cross-session file-result cache: TTL in seconds (default 604800 = 7 days)
# and LRU entry cap (default 4096). Only successful FileRef outputs are
# cached; DataFrame/Channel results stay session-local.
#AUTONOMICS_DAG_RESULT_CACHE_TTL_SECS=604800
#AUTONOMICS_DAG_RESULT_CACHE_MAX_ENTRIES=4096
# Daemon maintenance pass interval in seconds (default 900; 0 disables the
# background loop — explicit storage_status/clean_storage still work).
#AUTONOMICS_DAG_MAINTENANCE_INTERVAL_SECS=900
# Run-aware clean: the newest N runs are always protected (default 100).
#AUTONOMICS_DAG_CLEAN_KEEP_RUNS=100
# Local managed-root byte budget (work root + receipts root). 0 (default)
# DISABLES automatic deletion — cleanup then only happens through an explicit
# clean. When over budget, old-run workdirs/receipts are deleted oldest-first
# down to 75% of the budget. Immutable VFS artifacts, the history DB and logs
# are never deleted by this budget.
#AUTONOMICS_DAG_STORAGE_MAX_BYTES=0

# ── DNAnexus / UK Biobank ────────────────────────────────────────────────────
DX_AUTH_TOKEN=         # dx toolkit auth token
DX_PROJECT_CONTEXT_ID= # project-context hash, e.g. project-J3...

# ── Aliyun OSS ───────────────────────────────────────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ── Application Paths ────────────────────────────────────────────────────────
# Optional — each has a sensible default.

PHLOEM_CONFIG=phloem.json # phloem-server config file path
BIBLIOGRAPHY_SEARCH_DIR=/mnt/disk1/project/bibliography-search
DOWNLOAD_DIR_PATH=/mnt/disk2/dataset/autonomics_data
KMS_DB_PATH=/mnt/disk3/dendrite/data/kms_sqlite.db
KMS_LOG_PATH=/mnt/disk3/dendrite/data/kms.log
AUTONOMICS_MIXER_RESOURCE_SOURCE= # host MiXeR bundle root; defaults to /data then /mnt/data
AUTONOMICS_PLINK_REF_SOURCE_ROOT= # host 1000G PLINK root; defaults to complete deployed roots
PLINK_REF_PREFIX_TEMPLATE=        # shared prefix template, e.g. /refs/chr{N}/1000G.EUR.chr{N}.qc
LAVA_PLINK_REF_PREFIX_TEMPLATE=   # LAVA-only prefix template; defaults to the VFS panel mount

# ── Logging ──────────────────────────────────────────────────────────────────
# Controls tracing log levels. Required by dendrite/kms_tui (uses from_default_env).
# Optional for phloem-server and phloem-tui (use try_from_default_env with fallback).

RUST_LOG=info # e.g. phloem_server=debug,tower_http=debug

# Central resource downloader (state_dir/resource-downloader.toml is preferred).
# Example manifest:
# [policy]
# max_bytes = 1073741824
#
# [[policy.allow]]
# hosts = ["example.com"]
# path_prefixes = ["/data/"]
#
# [[object_store_profiles]]
# id = "public-s3"
# kind = "s3"
# bucket = "open-data"
# endpoint = "https://s3.example.com"
# allow_prefixes = ["/reference/"]
# access_key_id = "..."
# secret_access_key = "..."
