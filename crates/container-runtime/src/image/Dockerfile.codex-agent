FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates curl git jq less openssh-client procps ripgrep unzip zip \
       python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex@latest \
    && mkdir -p /workspace \
    && chown node:node /workspace

ENV HOME=/workspace/.home \
    XDG_CACHE_HOME=/workspace/.cache \
    SHELL=/bin/bash \
    LANG=C.UTF-8

USER node:node
WORKDIR /workspace
CMD ["/bin/sh", "-lc", "umask 0002; mkdir -p \"$HOME\" \"$XDG_CACHE_HOME\"; exec sleep infinity"]
