{
  "name": "autonomics-tui-http-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "build:css": "bunx tailwindcss -i src/index.css -o dist/styles.css --minify",
    "build:js": "bun build src/main.tsx --outfile dist/app.js --minify",
    "build": "bun run typecheck && bun run build:css && bun run build:js",
    "test": "bun test",
    "inspect": "bun run scripts/inspect.ts",
    "dev": "bun run scripts/dev.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.2.27",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  }
}
