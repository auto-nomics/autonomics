{
  "manifest_version": 3,
  "name": "Autonomics Library Connector",
  "version": "0.1.0",
  "description": "Preview and save scholarly metadata from the current page to your Autonomics library.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Autonomics"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "109"
}
