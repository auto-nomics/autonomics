    "test:katex": "node tests/wiki-katex.mjs",
    "test:pdf-selection": "node tests/pdf-selection.mjs",
    "test:pdf-tools": "node tests/pdf-tools.mjs",
    "test:reading-selection": "node tests/reading-selection.mjs",
    "test:highlight-notes": "node tests/highlight-notes.mjs",
    "test:reading": "node tests/reading-mode.mjs",
    "test:txt": "node tests/txt-reader.mjs",
    "test:vfs": "node tests/vfs-browser.mjs",
    "test:plugin-dev": "node tests/plugin-dev.mjs",
    "test:deck": "node tests/deck-viewer.mjs",
    "test:bib-menu": "node tests/bibliography-menu.mjs",
    "test:collections": "node tests/nested-collections.mjs",
    "test:bib-search": "node tests/bibliography-search.mjs",
    "test:bib-exploration": "node tests/literature-exploration.mjs",
