{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Application window permissions",
  "windows": [
    "main",
    "deck-presenter-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus"
  ]
}
