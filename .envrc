# =============================================================================
# .envrc — thin wrapper: .env is the single source of truth
# =============================================================================
# `dotenv .env` loads every KEY=VALUE from .env and exports it into the
# shell environment. `watch_file .env` makes direnv re-evaluate this file
# whenever .env changes — so editing .env is instantly reflected without
# running `direnv allow` again (this file itself never changes).
#
#   To add/change variables:  edit .env
#   This file:                DO NOT EDIT (except the direnv-only block below)
# =============================================================================

watch_file .env
dotenv .env

# ── direnv-only additions (deliberately NOT in .env) ─────────────────────────
# These belong to the developer's interactive shell, not to docker compose.

# r45 conda env — Rscript/ggplot2 for viz nodes
export PATH=/home/wjx/miniconda3/envs/r45/bin:$PATH
